# GOSH Frontend Environment Configuration Example
# Copy this file to .env.local (for local development) or .env.production (for production deployment)

# Base path for GitHub Pages (e.g. /love/)
VITE_BASE_PATH=/love/

# URL of your deployed backend server (e.g. Render, Railway, Fly.io, or VPS)
# When left empty, defaults to localhost:5000 in local development
VITE_API_URL=https://your-backend-app.onrender.com

# WebSocket URL for real-time messaging, presence, and WebRTC signaling
VITE_SOCKET_URL=https://your-backend-app.onrender.com

